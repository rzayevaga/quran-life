        {"number": 1, "arabic": "لِإِيلَافِ قُرَيْشٍ", "transliteration": "Li-ilafi Quraysh", "translation_az": "Qüreyşin ülfəti üçün,"}
      ]
    },
    {
      "id": 107, "name_ar": "الماعون", "name_az": "Maun", "name_trans": "Al-Ma'un",
      "type": "Məkkə", "ayah_count": 7, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ", "transliteration": "Ara'aytalladhi yukadhdhibu bid-din", "translation_az": "Dini yalan sayanı gördünmü?"}
      ]
    },
    {
      "id": 108, "name_ar": "الكوثر", "name_az": "Kövsər", "name_trans": "Al-Kawthar",
      "type": "Məkkə", "ayah_count": 3, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ", "transliteration": "Inna a'taynaka al-kawthar", "translation_az": "Həqiqətən, Biz sənə Kövsəri bəxş etdik!"}
      ]
    },
    {
      "id": 109, "name_ar": "الكافرون", "name_az": "Kafirun", "name_trans": "Al-Kafirun",
      "type": "Məkkə", "ayah_count": 6, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "قُلْ يَا أَيُّهَا الْكَافِرُونَ", "transliteration": "Qul ya ayyuhal-kafirun", "translation_az": "De: Ey kafirlər!"}
      ]
    },
    {
      "id": 110, "name_ar": "النصر", "name_az": "Nəsr", "name_trans": "An-Nasr",
      "type": "Mədinə", "ayah_count": 3, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ", "transliteration": "Idha ja'a nasrullahi wal-fath", "translation_az": "Allahın köməyi və zəfər gələcəyi zaman,"}
      ]
    },
    {
      "id": 111, "name_ar": "المسد", "name_az": "Məsəd", "name_trans": "Al-Masad",
      "type": "Məkkə", "ayah_count": 5, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ", "transliteration": "Tabbat yada abi Lahabiw-wa tabb", "translation_az": "Əbu Ləhəbin əlləri qurusun! O, özü də qurudu!"}
      ]
    },
    {
      "id": 112, "name_ar": "الإخلاص", "name_az": "İxlas", "name_trans": "Al-Ikhlas",
      "type": "Məkkə", "ayah_count": 4, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "قُلْ هُوَ اللَّهُ أَحَدٌ", "transliteration": "Qul Huwallahu Ahad", "translation_az": "De: O Allah Təkdir!"},
        {"number": 2, "arabic": "اللَّهُ الصَّمَدُ", "transliteration": "Allahus-Samad", "translation_az": "Allah heç nəyə möhtac deyil, hər şey Ona möhtacdır!"},
        {"number": 3, "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "transliteration": "Lam yalid wa lam yulad", "translation_az": "O, nə doğmuş, nə də doğulmuşdur!"},
        {"number": 4, "arabic": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ", "transliteration": "Wa lam yakul-lahu kufuwan ahad", "translation_az": "Və heç kəs Ona tay ola bilməz!"}
      ]
    },
    {
      "id": 113, "name_ar": "الفلق", "name_az": "Fələq", "name_trans": "Al-Falaq",
      "type": "Məkkə", "ayah_count": 5, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ", "transliteration": "Qul a'udhu bi-rabbil-falaq", "translation_az": "De: Sığınıram sübhün Rəbbinə!"},
        {"number": 2, "arabic": "مِن شَرِّ مَا خَلَقَ", "transliteration": "Min sharri ma khalaq", "translation_az": "Yaratdıqlarının şərindən,"},
        {"number": 3, "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "transliteration": "Wa min sharri ghasiqin idha waqab", "translation_az": "Qaranlığı çökən gecənin şərindən,"},
        {"number": 4, "arabic": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ", "transliteration": "Wa min sharrin-naffathati fil-'uqad", "translation_az": "Düyünlərə üfürən cadugərlərin şərindən"},
        {"number": 5, "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "transliteration": "Wa min sharri hasidin idha hasad", "translation_az": "Və paxıllıq edən paxılın şərindən!"}
      ]
    },
    {
      "id": 114, "name_ar": "الناس", "name_az": "Nas", "name_trans": "An-Nas",
      "type": "Məkkə", "ayah_count": 6, "juz": 30,
      "ayahs": [
        {"number": 1, "arabic": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ", "transliteration": "Qul a'udhu bi-rabbin-nas", "translation_az": "De: Sığınıram insanların Rəbbinə!"},
        {"number": 2, "arabic": "مَلِكِ النَّاسِ", "transliteration": "Malikin-nas", "translation_az": "İnsanların Hökmdarına,"},
        {"number": 3, "arabic": "إِلَٰهِ النَّاسِ", "transliteration": "Ilahin-nas", "translation_az": "İnsanların İlahına!"},
        {"number": 4, "arabic": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ", "transliteration": "Min sharril-waswasil-khannas", "translation_az": "Vəsvəsə verən və gizlənən Şeytanın şərindən,"},
        {"number": 5, "arabic": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ", "transliteration": "Alladhi yuwaswisu fi sudurin-nas", "translation_az": "O Şeytan ki, insanların qəlblərinə vəsvəsə salır,"},
        {"number": 6, "arabic": "مِنَ الْجِنَّةِ وَالنَّاسِ", "transliteration": "Minal-jinnati wan-nas", "translation_az": "İstər cinlərdən olsun, istər insanlardan!"}
      ]
    }
  ]
