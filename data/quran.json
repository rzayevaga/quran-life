      "ayahs": [
        {"number": 1, "arabic": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ", "transliteration": "Waylul-likulli humazatil-lumazah", "translation_az": "Vay halına qeybət edən və tənə vuran hər kəsin!"}
