        {"number": 2, "arabic": "إِنَّ الْإِنسَانَ لَفِي خُسْرٍ", "transliteration": "Innal-insana lafi khusr", "translation_az": "Həqiqətən, insan ziyan içərisindədir!"},
        {"number": 3, "arabic": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ", "transliteration": "Illalladhina amanu wa 'amilus-salihati...", "translation_az": "Yalnız iman gətirən, saleh əməllər edən, bir-birinə haqqı tövsiyə edən və səbri tövsiyə edənlər istisnadır!"}
      ]
    },
    {
      "id": 104, "name_ar": "الهمزة", "name_az": "Huməzə", "name_trans": "Al-Humaza",
